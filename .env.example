# Supabase -- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Server-only. Bypasses RLS -- never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Server-only. Postgres connection string, used by `npm run db:policies` (psql).
# Supabase dashboard: Connect (top bar) or Project Settings > Database >
# Connection string > URI. Replace [YOUR-PASSWORD] with your database password.
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# Optional -- used only by `npm run db:seed:users` to create the nine Phase 1
# accounts. Replace the domain with the school's real one and use a fresh
# temporary password before seeding production.
SEED_EMAIL_DOMAIN="fondation-rst.cm"
SEED_DEFAULT_PASSWORD="Uniforme2026!"

# Printed on receipts and Excel exports.
NEXT_PUBLIC_SCHOOL_NAME="Fondation Révélation Sainte Thérèse"
NEXT_PUBLIC_SCHOOL_ADDRESS="Cameroon"
NEXT_PUBLIC_SCHOOL_PHONE="+237 6 00 00 00 00"
NEXT_PUBLIC_CURRENCY="XAF"

# Sentry -- Phase 1 error tracking (Sentry > Settings > Projects > Client Keys).
# The DSN is public by design (it is shipped to the browser). Leave empty to
# disable Sentry entirely; the SDK becomes a no-op with no DSN.
NEXT_PUBLIC_SENTRY_DSN=""
# Server/CI only. Used to upload source maps at build time -- never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=""
